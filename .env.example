# Required — SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Optional — absolute URLs for SEO / Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:4317"

# Optional — Clerk sign-in. Without these the site runs fully; favorites use an anonymous browser cookie.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=""

# Optional — contact + media
NEXT_PUBLIC_WHATSAPP="923000000000"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/zhfilms"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/zhfilms"
NEXT_PUBLIC_CONTACT_EMAIL="hello@zhfilms.example"
NEXT_PUBLIC_HERO_VIDEO_URL=""
