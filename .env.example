# ─────────────────────────────────────────────────────────────
# ZH Films — environment variables
# Copy this file to `.env` and replace every value marked REPLACE_ME.
# Lines left empty ("") are optional — the site still runs without them.
# Never commit your real `.env` (it is already gitignored).
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────
# Supabase → Connect → ORM → Prisma. URL-encode special characters in the password.
# Pooled (port 6543) for the app, direct/session (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Storage: Supabase (server only — never expose the secret key) ──
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# ── Site URL (required in production) ────────────────────────
# Your public domain, used for SEO / Open Graph links. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:4317"
# e.g. NEXT_PUBLIC_SITE_URL="https://zhfilms.com"

# ── Sign-in: Clerk (needed for /account and /admin) ──────────
# Get both keys at https://dashboard.clerk.com → your app → API Keys.
# Leave BOTH empty to run without sign-in (bookings still work).
# Do not paste placeholder text here — an invalid key breaks sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""   # REPLACE_ME: starts with pk_test_ or pk_live_
CLERK_SECRET_KEY=""                    # REPLACE_ME: starts with sk_test_ or sk_live_

# Emails allowed into the staff dashboard (/admin), comma-separated.
# These people must sign in with exactly this email (verified in Clerk).
ADMIN_EMAILS="REPLACE_ME@example.com"
# e.g. ADMIN_EMAILS="zulfiqar@zhfilms.com,office@zhfilms.com"

# ── Contact details shown on the site ────────────────────────
# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP="923000000000"    # REPLACE_ME: e.g. 923451234567
NEXT_PUBLIC_CONTACT_EMAIL="REPLACE_ME@zhfilms.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/zulfiqar_hussain.films/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/people/ZH_films/100092306776654/"

# ── Hero video (optional) ────────────────────────────────────
# Leave empty to use public/media/hero.mp4 and its poster.
# Or point to a hosted file (muted H.264 MP4 works best).
NEXT_PUBLIC_HERO_VIDEO_URL=""
NEXT_PUBLIC_HERO_POSTER_URL=""

# ── Live Instagram feed (optional) ───────────────────────────
# Without these the site shows the saved posts in lib/instagram-media.json.
# Get them from Meta for Developers → Instagram API (Business/Creator account).
INSTAGRAM_ACCESS_TOKEN=""              # REPLACE_ME: long-lived access token
INSTAGRAM_USER_ID=""                   # REPLACE_ME: numeric Instagram user ID

# ── Email: Resend (optional — without it emails are logged as skipped) ──
RESEND_API_KEY=""                      # REPLACE_ME: starts with re_
EMAIL_FROM=""                          # e.g. "ZH Films <bookings@zhfilms.com>" (verified domain in Resend)
EMAIL_REPLY_TO=""                      # optional
OWNER_NOTIFY_EMAIL=""                  # where owner alerts go; falls back to Settings, then ADMIN_EMAILS

# ── Reminders cron ───────────────────────────────────────────
CRON_SECRET=""                         # REPLACE_ME: long random string, e.g. `openssl rand -hex 32`

# ── Receipt storage (optional) ───────────────────────────────
RECEIPTS_DIR=""                        # default: ./storage/receipts (must be persistent, not public)
