generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Reel {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("weddings")
  description String?
  videoUrl    String
  thumbnail   String
  durationSec Int      @default(60)
  featured    Boolean  @default(false)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
}

/// ownerId is either "user:<clerkId>" or "visitor:<uuid>" from the zh_vid cookie.
model Favorite {
  id        String   @id @default(cuid())
  ownerId   String
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([ownerId, itemType, itemId])
  @@index([itemType, itemId])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  eventType String
  rating    Int
  message   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  category  String
  mediaType String
  url       String
  thumbnail String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

model JournalPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  publishedAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("directors_cut")
  createdAt DateTime @default(now())
}

model Booking {
  id               String   @id @default(cuid())
  confirmationCode String   @unique
  names            String
  city             String
  eventDate        String
  coverage         String
  deliverables     String
  references       String   @default("")
  email            String
  phone            String
  /// wedding | nikah | event | shoot | photography | videography (see lib/booking-rules.ts)
  serviceType      String   @default("event")
  /// Wall-clock times in `timezone`; endTime earlier than startTime means it runs past midnight.
  startTime        String?
  endTime          String?
  timezone         String   @default("Asia/Karachi")
  startsAt         DateTime?
  endsAt           DateTime?
  /// Event window widened by setup/travel buffers — this is what conflicts are checked against.
  blockStart       DateTime?
  blockEnd         DateTime?
  teamId           String   @default("film-family")
  /// Set only by staff: a pending request blocks its slot until this time.
  holdExpiresAt    DateTime?
  heldBy           String?
  /// Agreed total and required advance, in PKR. Set by staff.
  quotedAmount     Int?
  advanceAmount    Int?
  /// Secret for the customer's private booking link (emails), compared server-side.
  accessToken      String?  @unique
  /// pending | confirmed | completed | declined | cancelled
  status           String   @default("pending")
  /// Set by staff only: not_requested | awaiting | paid | refunded
  paymentStatus    String   @default("not_requested")
  idempotencyKey   String?  @unique
  clerkUserId      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  /// general | wedding_package | event
  kind             String   @default("general")
  /// Event booking type (nikah, engagement, birthday, corporate, other, shoot)
  eventType        String?
  /// Package snapshot at request time; prices are computed on the server from the catalog.
  packageId        String?
  packageName      String?
  packagePrice     Int?
  /// JSON array of { id, name, price } add-ons selected by the customer.
  addonsJson       String?
  estimatedTotal   Int?
  /// Free-text budget or custom-deal wish from the customer. Not a price.
  budget           String?
  customDealRequested Boolean @default(false)
  whatsappRequested   Boolean @default(false)

  payments         Payment[]
  events           BookingEvent[]
  functions        BookingFunction[]

  @@index([teamId, blockStart, blockEnd])
  @@index([status, createdAt])
}

/// A payment the customer reports. Never "verified" until staff check the real account.
model Payment {
  id              String    @id @default(cuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// easypaisa | bank
  method          String
  amount          Int
  reference       String
  payerName       String    @default("")
  /// Path under storage/receipts (outside /public); served only to admins.
  receiptPath     String?
  receiptMime     String?
  /// submitted | verified | rejected
  status          String    @default("submitted")
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
  @@index([bookingId])
}

/// Audit trail for every status, hold, quote and payment change.
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actor     String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

/// Owner-editable settings (payment instructions, policies). JSON value per key.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Every email attempt. `dedupeKey` makes reminders and notices send at most once.
model EmailLog {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  kind      String
  to        String
  subject   String
  bookingId String?
  /// sent | failed | skipped (provider not configured)
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One row per production team. Bumped as the first write of every booking transaction so
/// concurrent requests for the same team are serialized before conflicts are checked.
model ScheduleLock {
  teamId    String   @id
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model HireRequest {
  id          String   @id @default(cuid())
  crewId      String
  crewName    String
  eventDate   String
  brief       String
  clientName  String
  email       String
  phone       String
  status      String   @default("pending")
  clerkUserId String?
  createdAt   DateTime @default(now())
}

model RentalInquiry {
  id          String   @id @default(cuid())
  gearId      String
  gearName    String
  category    String
  startDate   String
  endDate     String   @default("")
  clientName  String
  email       String
  phone       String
  message     String   @default("")
  status      String   @default("pending")
  clerkUserId String?
  createdAt   DateTime @default(now())
}

model SellInquiry {
  id          String   @id @default(cuid())
  gearId      String?
  gearName    String
  category    String
  clientName  String
  email       String
  phone       String
  message     String   @default("")
  status      String   @default("pending")
  clerkUserId String?
  createdAt   DateTime @default(now())
}

model CrewMember {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  role      String
  title     String
  bio       String
  image     String
  yearsExp  String  @default("3+")
  specialty String  @default("weddings")
  whatsapp  String?
  instagram String?
  facebook  String?
  email     String?
  featured  Boolean @default(false)
  sortOrder Int     @default(0)
}

model GearItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  brand       String
  category    String
  listingType String
  priceLabel  String
  description String
  image       String
  available   Boolean @default(true)
  sortOrder   Int     @default(0)
}

/// One function of a booking (e.g. Mehndi, Baraat). Every slot is checked for conflicts;
/// the first function is mirrored on the Booking row for older code paths.
model BookingFunction {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type       String
  eventDate  String
  startTime  String
  endTime    String
  venue      String   @default("")
  startsAt   DateTime
  endsAt     DateTime
  blockStart DateTime
  blockEnd   DateTime
  teamId     String   @default("film-family")
  sortOrder  Int      @default(0)

  @@index([teamId, blockStart, blockEnd])
  @@index([bookingId])
}
